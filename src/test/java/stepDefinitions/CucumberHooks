package step_definitions;

import io.cucumber.java.*;

public class CucumberHooks extends Helper {

    @Before
    public void setUp() {
        // Code to run before each scenario
        logger.info("Before scenario hook executed.");
    }

    @After
    public void tearDown() {
        // Code to run after each scenario
        logger.info("After scenario hook executed.");
    }

    @BeforeStep
    public void beforeStep(Scenario scenario) {
        // Code to run before each step
        logger.info("Before step hook executed."+ scenario.getName());
    }

    @AfterStep
    public void afterStep(Scenario scenario) {
        // Code to run after each step
        logger.info("After step hook executed."+ scenario.getName());  
        logger.info("Scenario status: " + scenario.getStatus().toString());
    }

    @BeforeAll
    public static void beforeAll() {
        // Code to run once before all scenarios
        System.out.println("Before all scenarios hook executed.");
    }

    @AfterAll
    public static void afterAll() {
        // Code to run once after all scenarios
        logger.info("After all scenarios hook executed.");
    }

    @onTestFailure
    public void onTestFailure() {
        logger.error("Test Failed: " + result.getTestName() + " - " + result.getName());

        // 2. Thực hiện chụp màn hình
        if (DriverManager.getDriver() != null) {
            captureScreenshot(result.getName()+"_onTestFailure");
        }
    }
}